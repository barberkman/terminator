{
  "name": "terminator",
  "version": "0.1.0",
  "private": true,
  "description": "Supervise multiple Claude Code and terminal sessions from one window",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:scripting": "node test/scripting/e2e.js",
    "test:mac": "node test/mac/e2e.js",
    "dist": "electron-vite build && electron-builder",
    "dist:linux": "electron-vite build && electron-builder --linux AppImage",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac"
  },
  "build": {
    "appId": "com.terminator.desktop",
    "productName": "Terminator",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "**/node_modules/@lydell/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "Sessions run, and the editor and file tree read, in the project folders you open — some of which live in Documents.",
        "NSDesktopFolderUsageDescription": "Sessions run, and the editor and file tree read, in the project folders you open — some of which live on the Desktop.",
        "NSDownloadsFolderUsageDescription": "Sessions run, and the editor and file tree read, in the project folders you open — some of which live in Downloads.",
        "NSRemovableVolumesUsageDescription": "Sessions can run in project folders on removable drives.",
        "NSNetworkVolumesUsageDescription": "Sessions can run in project folders on network drives.",
        "NSAppleEventsUsageDescription": "Programs run in a session — Claude, scripts, osascript — may control other apps when you ask them to.",
        "NSLocalNetworkUsageDescription": "Browser panes and programs run in a session can reach servers on your local network."
      }
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "@lydell/node-pty": "1.1.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@lezer/highlight": "^1.2.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "pdfjs-dist": "6.3.289",
    "playwright-core": "1.56.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "zustand": "^5.0.14"
  }
}
